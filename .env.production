# YeboMart PWA / POS app — production build env
#
# Inlined into the Vite bundle at build time. clientId is a public PKCE
# identifier, safe to commit.

VITE_API_URL=https://api.yebomart.com

# YeboID — PROD environment (client registered on the yeboid prod DB,
# slug='yebomart'). Endpoints mirror
# https://api.yeboid.com/.well-known/openid-configuration — authorize is the
# HTML login UI on yeboid.com, token/userinfo are on the API host.
VITE_YEBOID_CLIENT_ID=yebo_880f3d190f1e0209ccac777eceec6277
VITE_YEBOID_AUTH_URL=https://yeboid.com/oauth/authorize
VITE_YEBOID_TOKEN_URL=https://api.yeboid.com/oauth/token
VITE_YEBOID_USERINFO_URL=https://api.yeboid.com/oauth/userinfo
