# YeboMart PWA / POS app — local dev / `vite dev` env

VITE_API_URL=https://dev-api.yebomart.com

# YeboID — DEV environment. These MUST point at dev: the client_id below is
# registered on the yeboid DEV database and is rejected by the prod
# authorization server. Endpoints mirror
# https://dev-api.yeboid.com/.well-known/openid-configuration — authorize is the
# HTML login UI on dev.yeboid.com, token/userinfo are on the API host.
VITE_YEBOID_CLIENT_ID=yebo_998734d7562db4219d66d7f88b0d21f9
VITE_YEBOID_AUTH_URL=https://dev.yeboid.com/oauth/authorize
VITE_YEBOID_TOKEN_URL=https://dev-api.yeboid.com/oauth/token
VITE_YEBOID_USERINFO_URL=https://dev-api.yeboid.com/oauth/userinfo
